# Copy to .env beside the deployment JSON. Do not commit .env.
# Explicit process environment variables override this file; quote values with spaces.
# JSON remains the static fallback for the supported override fields below.
# Fill only the channel in use. Values are loaded once, at bootstrap.
# Email IMAP acquisition (SMTP host/port/security remain in the email JSON object).
PT_IMAP_HOST=
PT_IMAP_PORT=993
PT_IMAP_SECURITY=tls
PT_IMAP_MAILBOX=INBOX
PT_IMAP_USERNAME=
PT_IMAP_PASSWORD=
PT_IMAP_TIMEOUT_SECONDS=30
PT_IMAP_POLL_SECONDS=30
PT_IMAP_BATCH_SIZE=32
# Set when SMTP authentication is configured.
PT_SMTP_PASSWORD=

# Telegram private text acquisition/reply. Replace all placeholders before starting.
# Obtain a dedicated bot token from BotFather; never commit or print it.
PT_TELEGRAM_BOT_TOKEN=replace-with-bot-token
# Numeric ID identifying that bot (the token's numeric prefix).
PT_TELEGRAM_BOT_ID=123456789
# Exact numeric Telegram User ID -> existing/deployment Actor ID. No usernames.
PT_TELEGRAM_IDENTITIES='{"telegram:987654321":"actor-1"}'
# Socket timeout must exceed the long poll duration (1..50 seconds).
PT_TELEGRAM_TIMEOUT_SECONDS=40
PT_TELEGRAM_LONG_POLL_SECONDS=30
# Positive delay between cycles; exponential error backoff capped at max(this, 300).
PT_TELEGRAM_POLL_SECONDS=1
# getUpdates limit: 1..100 updates per cycle.
PT_TELEGRAM_BATCH_SIZE=32
